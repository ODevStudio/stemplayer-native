{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://odevstudio.example/stemplayer-native/measurement-v1.schema.json",
  "title": "Stemplayer native measurement report v1",
  "type": "object",
  "required": ["schema", "status", "timestamp_utc", "build", "machine", "scenario", "samples", "limitations"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "stemplayer-native-measurement-v1" },
    "status": { "enum": ["passed", "failed", "incomplete"] },
    "timestamp_utc": { "type": "string", "format": "date-time" },
    "build": {
      "type": "object",
      "required": ["rustc", "profile", "binary_bytes", "binary_sha256", "lock_sha256"],
      "additionalProperties": false,
      "properties": {
        "rustc": { "type": "string" },
        "profile": { "const": "release" },
        "binary_bytes": { "type": "integer", "minimum": 1 },
        "binary_sha256": { "$ref": "#/$defs/hash" },
        "lock_sha256": { "$ref": "#/$defs/hash" }
      }
    },
    "machine": {
      "type": "object",
      "required": ["os", "architecture", "cpu", "logical_cores", "memory_bytes", "renderer"],
      "additionalProperties": true,
      "properties": {
        "os": { "type": "string" },
        "architecture": { "type": "string" },
        "cpu": { "type": "string" },
        "logical_cores": { "type": "integer", "minimum": 1 },
        "memory_bytes": { "type": "integer", "minimum": 1 },
        "renderer": { "type": "string" },
        "audio_device": { "type": ["string", "null"] },
        "sample_rate": { "type": ["integer", "null"] }
      }
    },
    "scenario": { "type": "string", "minLength": 1 },
    "fixture": {
      "type": ["object", "null"],
      "required": ["alias", "sha256"],
      "additionalProperties": false,
      "properties": {
        "alias": { "type": "string" },
        "sha256": { "$ref": "#/$defs/hash" }
      }
    },
    "samples": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["elapsed_ms", "private_bytes", "resident_bytes", "cpu_normalized_percent"],
        "additionalProperties": true,
        "properties": {
          "elapsed_ms": { "type": "number", "minimum": 0 },
          "private_bytes": { "type": "integer", "minimum": 0 },
          "resident_bytes": { "type": "integer", "minimum": 0 },
          "cpu_normalized_percent": { "type": "number", "minimum": 0 },
          "handles": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "limitations": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
