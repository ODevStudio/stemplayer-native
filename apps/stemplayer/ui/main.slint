import { Button, CheckBox, ComboBox, HorizontalBox, Palette, RadioGroup, ScrollView, Slider, VerticalBox } from "std-widgets.slint";

component MixerRow inherits Rectangle {
    in property <int> role-index;
    in property <string> role-name;
    in-out property <float> gain-position;
    in property <string> gain-text;
    in-out property <bool> muted;
    in-out property <bool> soloed;
    in property <bool> enabled;
    callback gain-changed(float);
    callback gain-commit();
    callback mute-changed(bool);
    callback solo-changed(bool);
    height: 44px;
    background: Palette.alternate-background;
    border-color: Palette.border;
    border-width: 1px;
    accessible-role: groupbox;
    accessible-label: role-name + " mixer";

    HorizontalBox {
        padding: 7px;
        spacing: 8px;

        Text {
            text: role-name;
            width: 62px;
            vertical-alignment: center;
        }

        gain-slider := Slider {
            value <=> gain-position;
            minimum: 0;
            maximum: 1000;
            enabled: root.enabled;
            accessible-label: role-name + " gain";
            accessible-value: gain-text;
            changed(value) => { root.gain-changed(value); }
            released(value) => { root.gain-changed(value); root.gain-commit(); }
        }

        Button {
            text: "-";
            width: 30px;
            enabled: root.enabled && root.gain-position > 0;
            accessible-label: "Decrease " + role-name + " gain";
            clicked => {
                root.gain-position = max(0, root.gain-position - 10);
                root.gain-changed(root.gain-position);
                root.gain-commit();
            }
        }

        Button {
            text: root.gain-text;
            width: 58px;
            enabled: root.enabled;
            accessible-label: "Reset " + role-name + " gain to 100 percent";
            clicked => {
                root.gain-position = 800;
                root.gain-changed(root.gain-position);
                root.gain-commit();
            }
        }

        Button {
            text: "+";
            width: 30px;
            enabled: root.enabled && root.gain-position < 1000;
            accessible-label: "Increase " + role-name + " gain";
            clicked => {
                root.gain-position = min(1000, root.gain-position + 10);
                root.gain-changed(root.gain-position);
                root.gain-commit();
            }
        }

        mute := Button {
            text: "Mute";
            checkable: true;
            checked <=> root.muted;
            enabled: root.enabled;
            accessible-label: "Mute " + role-name;
            clicked => { root.mute-changed(self.checked); }
        }

        solo := Button {
            text: "Solo";
            checkable: true;
            checked <=> root.soloed;
            enabled: root.enabled;
            accessible-label: "Solo " + role-name;
            clicked => { root.solo-changed(self.checked); }
        }
    }
}

export component AppWindow inherits Window {
    title: "Stemplayer Native";
    preferred-width: 780px;
    preferred-height: 620px;
    min-width: 560px;
    min-height: 400px;
    background: Palette.background;
    accessible-role: main;
    accessible-label: "Stemplayer native player";

    in property <string> source-name: "No source loaded";
    in property <string> source-summary: "";
    in property <string> state-text: "Empty";
    in property <string> time-text: "0:00 / 0:00";
    in property <string> output-mode: "Stem mix";
    in property <bool> has-master: false;
    in-out property <int> output-preference: 0;
    in property <[string]> output-devices: ["System default"];
    in-out property <int> output-device-index: 0;
    in property <string> device-name: "System default";
    in property <[string]> recent-sources: [];
    in-out property <int> recent-source-index: 0;
    in-out property <bool> recent-sources-enabled: true;
    in-out property <int> theme-preference: 0;
    in-out property <bool> waveform-cache-enabled: false;
    in-out property <int> waveform-cache-limit-index: 1;
    in property <string> waveform-text: "Waveform unavailable";
    in property <string> buffering-text: "";
    in property <string> output-rate-text: "Output rate unavailable";
    in property <string> error-text: "";
    in property <string> error-action: "";
    in property <string> error-code: "";
    in property <string> error-status: "";
    in property <string> error-details: "";
    in-out property <bool> error-details-visible: false;
    in property <bool> can-open: true;
    in property <bool> can-play: false;
    in property <bool> can-pause: false;
    in property <bool> can-stop: false;
    in property <bool> can-seek: false;
    in property <bool> can-mix: false;
    in-out property <float> drums-gain-position: 800;
    in-out property <float> bass-gain-position: 800;
    in-out property <float> other-gain-position: 800;
    in-out property <float> vocals-gain-position: 800;
    in property <string> drums-gain-text: "100%";
    in property <string> bass-gain-text: "100%";
    in property <string> other-gain-text: "100%";
    in property <string> vocals-gain-text: "100%";
    in-out property <bool> drums-muted: false;
    in-out property <bool> bass-muted: false;
    in-out property <bool> other-muted: false;
    in-out property <bool> vocals-muted: false;
    in-out property <bool> drums-soloed: false;
    in-out property <bool> bass-soloed: false;
    in-out property <bool> other-soloed: false;
    in-out property <bool> vocals-soloed: false;
    in-out property <float> seek-position: 0;
    in-out property <bool> diagnostics-visible: false;
    in property <string> diagnostics-text: "";
    in-out property <bool> window-minimized <=> root.minimized;

    callback open-source();
    callback open-manifest();
    callback open-folder();
    callback open-recent(int);
    callback clear-recent();
    callback set-recent-sources-enabled(bool);
    callback retry-device(int);
    callback reset-player();
    callback play();
    callback pause();
    callback stop();
    callback seek(float);
    callback set-gain(int, float);
    callback commit-commands();
    callback set-mute(int, bool);
    callback set-solo(int, bool);
    callback snapshot-tick();
    callback reset-mix();
    callback set-output-preference(int);
    callback select-output-device(int);
    callback tick();

    changed theme-preference => {
        Palette.color-scheme = root.theme-preference == 1 ? ColorScheme.light : root.theme-preference == 2 ? ColorScheme.dark : ColorScheme.unknown;
    }

    function reset-mixer-controls() {
        root.drums-gain-position = 800;
        root.bass-gain-position = 800;
        root.other-gain-position = 800;
        root.vocals-gain-position = 800;
        root.drums-muted = false;
        root.bass-muted = false;
        root.other-muted = false;
        root.vocals-muted = false;
        root.drums-soloed = false;
        root.bass-soloed = false;
        root.other-soloed = false;
        root.vocals-soloed = false;
        root.output-preference = 0;
    }

    Timer {
        interval: 500ms;
        running: root.can-pause && !root.minimized;
        triggered => { root.tick(); }
    }
    Timer {
        interval: 1000ms;
        running: root.can-pause && !root.minimized;
        triggered => { root.snapshot-tick(); }
    }


    shortcuts := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Space) {
                if (root.can-pause) { root.pause(); }
                else if (root.can-play) { root.play(); }
                accept
            } else {
                reject
            }
        }
        KeyBinding { keys: @keys(Control + O); enabled: root.can-open; activated => { root.open-source(); } }
        KeyBinding { keys: @keys(Control + Shift + O); enabled: root.can-open; activated => { root.open-folder(); } }
        KeyBinding {
            keys: @keys(P);
            activated => {
                if (root.can-pause) { root.pause(); }
                else if (root.can-play) { root.play(); }
            }
        }
        KeyBinding { keys: @keys(S); enabled: root.can-stop; activated => { root.stop(); } }
        KeyBinding { keys: @keys(R); enabled: root.can-mix; activated => { root.reset-mix(); } }
        KeyBinding {
            keys: @keys(LeftArrow);
            enabled: root.can-seek;
            activated => {
                root.seek-position = max(0, root.seek-position - 0.05);
                root.seek(root.seek-position);
            }
        }
        KeyBinding {
            keys: @keys(RightArrow);
            enabled: root.can-seek;
            activated => {
                root.seek-position = min(1, root.seek-position + 0.05);
                root.seek(root.seek-position);
            }
        }
        KeyBinding { keys: @keys(D); activated => { root.diagnostics-visible = !root.diagnostics-visible; } }
        KeyBinding { keys: @keys(Alt + "1"); enabled: root.can-mix; activated => { root.drums-muted = !root.drums-muted; root.set-mute(0, root.drums-muted); } }
        KeyBinding { keys: @keys(Alt + "2"); enabled: root.can-mix; activated => { root.bass-muted = !root.bass-muted; root.set-mute(1, root.bass-muted); } }
        KeyBinding { keys: @keys(Alt + "3"); enabled: root.can-mix; activated => { root.other-muted = !root.other-muted; root.set-mute(2, root.other-muted); } }
        KeyBinding { keys: @keys(Alt + "4"); enabled: root.can-mix; activated => { root.vocals-muted = !root.vocals-muted; root.set-mute(3, root.vocals-muted); } }
        KeyBinding { keys: @keys(Alt + Shift + "1"); enabled: root.can-mix; activated => { root.drums-soloed = !root.drums-soloed; root.set-solo(0, root.drums-soloed); } }
        KeyBinding { keys: @keys(Alt + Shift + "2"); enabled: root.can-mix; activated => { root.bass-soloed = !root.bass-soloed; root.set-solo(1, root.bass-soloed); } }
        KeyBinding { keys: @keys(Alt + Shift + "3"); enabled: root.can-mix; activated => { root.other-soloed = !root.other-soloed; root.set-solo(2, root.other-soloed); } }
        KeyBinding { keys: @keys(Alt + Shift + "4"); enabled: root.can-mix; activated => { root.vocals-soloed = !root.vocals-soloed; root.set-solo(3, root.vocals-soloed); } }

    content := Rectangle {
        width: min(root.width, 920px);
        height: min(root.height, 640px);
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        background: Palette.background;

        ScrollView {
            VerticalBox {
                padding: 10px;
                spacing: 5px;

        HorizontalBox {
            spacing: 8px;
            Button {
                text: "Container";
                primary: true;
                enabled: root.can-open;
                accessible-label: "Open stem container";
                clicked => { root.open-source(); }
            }
            Button {
                text: "Manifest";
                enabled: root.can-open;
                accessible-label: "Open Studio bundle manifest";
                clicked => { root.open-manifest(); }
            }
            Button {
                text: "Folder";
                enabled: root.can-open;
                accessible-label: "Open Studio bundle folder";
                clicked => { root.open-folder(); }
            }
            VerticalBox {
                spacing: 2px;
                Text { text: root.source-name; font-size: 16px; font-weight: 600; overflow: elide; }
                Text { text: root.source-summary; color: Palette.foreground.with-alpha(0.7); overflow: elide; }
            }
            Text {
                text: root.buffering-text == "" ? root.state-text : root.buffering-text;
                vertical-alignment: center;
                horizontal-alignment: right;
            }
        }

        if root.error-text != "": Rectangle {
            height: root.error-details-visible ? 120px : 88px;
            background: #8f2525;
            accessible-label: root.error-text + ". " + root.error-status + ". " + root.error-action + ". " + root.error-code;
            accessible-role: groupbox;
            VerticalBox {
                padding: 6px;
                spacing: 4px;
                Text { text: root.error-text; color: white; font-weight: 600; wrap: word-wrap; }
                Text { text: root.error-status + ". " + root.error-action + ". " + root.error-code; color: white; wrap: word-wrap; }
                HorizontalBox {
                    spacing: 6px;
                    Button { text: "Retry output"; clicked => { root.retry-device(root.output-device-index); } }
                    Button { text: "Choose source"; clicked => { root.open-source(); } }
                    Button { text: "Reset player"; clicked => { root.reset-player(); } }
                    Button {
                        text: root.error-details-visible ? "Hide details" : "Details";
                        clicked => { root.error-details-visible = !root.error-details-visible; }
                    }
                }
                if root.error-details-visible: Text {
                    text: root.error-details == "" ? "No additional details" : root.error-details;
                    color: white;
                    wrap: word-wrap;
                }
            }
        }

        if root.error-text == "": Rectangle {
            height: 60px;
            background: Palette.alternate-background;
            border-color: Palette.border;
            border-width: 1px;
            accessible-role: image;
            accessible-label: root.waveform-text;

            VerticalBox {
                padding: 8px;
                spacing: 4px;
                Text {
                    text: root.waveform-text;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                seek-slider := Slider {
                    minimum: 0;
                    maximum: 1;
                    value <=> root.seek-position;
                    enabled: root.can-seek;
                    accessible-label: "Playback position";
                    released(value) => { root.seek(value); }
                }
            }
        }

        HorizontalBox {
            spacing: 7px;
            Button { text: "Play"; enabled: root.can-play; clicked => { root.play(); } }
            Button { text: "Pause"; enabled: root.can-pause; clicked => { root.pause(); } }
            Button { text: "Stop"; enabled: root.can-stop; clicked => { root.stop(); } }
            Button {
                text: "Reset";
                enabled: root.can-mix;
                clicked => { root.reset-mixer-controls(); root.reset-mix(); }
            }
            Text { text: root.time-text; vertical-alignment: center; }
            Text { text: root.output-mode; vertical-alignment: center; horizontal-alignment: right; }
        }

        MixerRow {
            role-index: 0; role-name: "Drums"; gain-position <=> root.drums-gain-position; gain-text: root.drums-gain-text; enabled: root.can-mix;
            muted <=> root.drums-muted; soloed <=> root.drums-soloed;
            gain-changed(value) => { root.set-gain(0, value); }
            gain-commit => { root.commit-commands(); }
            mute-changed(value) => { root.set-mute(0, value); }
            solo-changed(value) => { root.set-solo(0, value); }
        }
        MixerRow {
            role-index: 1; role-name: "Bass"; gain-position <=> root.bass-gain-position; gain-text: root.bass-gain-text; enabled: root.can-mix;
            muted <=> root.bass-muted; soloed <=> root.bass-soloed;
            gain-changed(value) => { root.set-gain(1, value); }
            gain-commit => { root.commit-commands(); }
            mute-changed(value) => { root.set-mute(1, value); }
            solo-changed(value) => { root.set-solo(1, value); }
        }
        MixerRow {
            role-index: 2; role-name: "Other"; gain-position <=> root.other-gain-position; gain-text: root.other-gain-text; enabled: root.can-mix;
            muted <=> root.other-muted; soloed <=> root.other-soloed;
            gain-changed(value) => { root.set-gain(2, value); }
            gain-commit => { root.commit-commands(); }
            mute-changed(value) => { root.set-mute(2, value); }
            solo-changed(value) => { root.set-solo(2, value); }
        }
        MixerRow {
            role-index: 3; role-name: "Vocals"; gain-position <=> root.vocals-gain-position; gain-text: root.vocals-gain-text; enabled: root.can-mix;
            muted <=> root.vocals-muted; soloed <=> root.vocals-soloed;
            gain-changed(value) => { root.set-gain(3, value); }
            gain-commit => { root.commit-commands(); }
            mute-changed(value) => { root.set-mute(3, value); }
            solo-changed(value) => { root.set-solo(3, value); }
        }

        output-mode-selector := RadioGroup {
            title: "Output mode";
            orientation: horizontal;
            enabled: root.can-mix;
            selected(value) => {
                root.output-preference = value == "Automatic" ? 0 : value == "Master reference" ? 1 : 2;
                root.set-output-preference(root.output-preference);
            }
            RadioButton { text: "Automatic"; checked: root.output-preference == 0; }
            RadioButton { text: "Master reference"; checked: root.output-preference == 1; enabled: root.has-master; }
            RadioButton { text: "Stem mix"; checked: root.output-preference == 2; }
        }

        HorizontalBox {
            spacing: 7px;
            Text { text: "Output"; vertical-alignment: center; }
            output-device-selector := ComboBox {
                model: root.output-devices;
                current-index <=> root.output-device-index;
                accessible-label: "Output device";
                selected(value) => { root.select-output-device(self.current-index); }
            }
            Text {
                text: root.output-rate-text;
                vertical-alignment: center;
                accessible-label: root.output-rate-text;
            }
            Text { text: "Theme"; vertical-alignment: center; }
            ComboBox {
                model: ["System", "Light", "Dark"];
                current-index <=> root.theme-preference;
                accessible-label: "Theme";
            }
            CheckBox {
                text: "Diagnostics";
                checked <=> root.diagnostics-visible;
            }
        }

        HorizontalBox {
            spacing: 7px;
            recent-selector := ComboBox {
                model: root.recent-sources;
                current-index <=> root.recent-source-index;
                enabled: root.recent-sources.length > 0;
                accessible-label: "Recent source";
            }
            Button {
                text: "Open recent";
                enabled: root.can-open && root.recent-sources.length > 0;
                clicked => { root.open-recent(root.recent-source-index); }
            }
            Button {
                text: "Clear";
                enabled: root.recent-sources.length > 0;
                accessible-label: "Clear recent sources";
                clicked => { root.clear-recent(); }
            }
            CheckBox {
                text: "Remember";
                checked <=> root.recent-sources-enabled;
                accessible-label: "Remember recent sources";
                toggled => { root.set-recent-sources-enabled(self.checked); }
            }
            CheckBox {
                text: "Waveform cache";
                checked <=> root.waveform-cache-enabled;
            }
            ComboBox {
                model: ["64 MB", "256 MB", "1 GB", "4 GB"];
                current-index <=> root.waveform-cache-limit-index;
                enabled: root.waveform-cache-enabled;
                accessible-label: "Waveform cache limit";
            }
        }

        if root.diagnostics-visible: Rectangle {
            height: 54px;
            background: Palette.alternate-background;
            border-color: Palette.border;
            border-width: 1px;
            accessible-role: groupbox;
            accessible-label: "Diagnostics";
            Text {
                text: root.diagnostics-text;
                vertical-alignment: center;
                horizontal-alignment: center;
                wrap: word-wrap;
                font-size: 11px;
            }
        }
    }
}
}
}
}
