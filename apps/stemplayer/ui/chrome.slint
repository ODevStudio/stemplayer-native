import { Button, Palette, ScrollView } from "std-widgets.slint";

export component IconButton inherits Rectangle {
    in property <string> glyph;
    in property <string> label;
    in property <bool> enabled: true;
    in property <bool> active: false;
    callback clicked();
    width: 34px;
    height: 32px;

    Button {
        width: parent.width;
        height: parent.height;
        text: "";
        enabled: root.enabled;
        accessible-label: root.label;
        clicked => { root.clicked(); }
    }

    Text {
        width: parent.width;
        height: parent.height;
        text: root.glyph;
        font-family: "Segoe Fluent Icons";
        font-size: 16px;
        color: root.enabled ? Palette.foreground : Palette.foreground.with-alpha(0.4);
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    if root.active: Rectangle {
        x: 8px;
        y: parent.height - 3px;
        width: parent.width - 16px;
        height: 2px;
        background: Palette.accent-background;
    }
    Tooltip { text: @markdown("\{root.label}"); }
}

export struct PlaylistRow {
    label: string,
    selected: bool,
}

export component PlaylistPanel inherits Rectangle {
    in property <[PlaylistRow]> items;
    in-out property <int> selected-index: 0;
    in-out property <bool> expanded: true;
    callback selected(int, bool, bool);
    callback context-selected(int);
    callback reordered(int, int);
    callback activated(int);
    callback select-all();
    callback remove-selected();
    min-height: 34px;
    preferred-height: root.expanded ? min(190px, 34px + root.items.length * 28px) : 34px;
    max-height: root.expanded ? 100000px : 34px;
    vertical-stretch: root.expanded ? 1 : 0;
    background: Palette.alternate-background;
    border-color: Palette.border;
    border-width: 1px;
    border-radius: 3px;
    accessible-role: list;
    accessible-label: "Track list";
    private property <int> drag-source: -1;
    private property <int> drag-target: -1;
    private property <length> context-popup-x: 0px;
    private property <length> context-popup-y: 0px;

    IconButton {
        x: 2px;
        y: 1px;
        width: 30px;
        height: 30px;
        glyph: root.expanded ? "\u{E70E}" : "\u{E70D}";
        label: root.expanded ? "Collapse track list" : "Expand track list";
        clicked => { root.expanded = !root.expanded; }
    }
    Text {
        x: 38px;
        y: 1px;
        z: 2;
        width: parent.width - 44px;
        height: 32px;
        text: root.items.length == 0 || root.selected-index < 0
            ? "No track selected"
            : root.items[root.selected-index].label;
        color: Palette.foreground;
        font-size: 12px;
        font-weight: 600;
        vertical-alignment: center;
        overflow: elide;
    }
    if root.expanded: list-focus := FocusScope {
        x: 2px;
        y: 34px;
        width: parent.width - 4px;
        height: parent.height - 36px;
        KeyBinding { keys: @keys(Control + A); activated => { root.select-all(); } }
        KeyBinding { keys: @keys(Delete); activated => { root.remove-selected(); } }
        KeyBinding { keys: @keys(Return); activated => { if root.selected-index >= 0 { root.activated(root.selected-index); } } }
        ScrollView {
            private property <int> selected-row: root.selected-index;
            width: parent.width;
            height: parent.height;
            vertical-scrollbar-policy: ScrollBarPolicy.always-on;
            horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
            changed selected-row => { self.reveal-selected-row(); }
            changed visible-height => { self.reveal-selected-row(); }
            changed viewport-height => { self.reveal-selected-row(); }

            function reveal-selected-row() {
                if self.selected-row >= 0 && self.selected-row < root.items.length && self.visible-height > 0px {
                    let top = self.selected-row * 28px;
                    let bottom = top + 27px;
                    self.viewport-y = min(0px, max(
                        self.visible-height - self.viewport-height,
                        max(-top, min(self.viewport-y, self.visible-height - bottom)),
                    ));
                }
            }

            list-rows := VerticalLayout {
                spacing: 1px;
                for item[index] in root.items: row := Rectangle {
                    height: 27px;
                    background: item.selected ? Palette.selection-background : row-area.has-hover ? Palette.background : transparent;
                    border-color: index == root.drag-target && root.drag-target != root.drag-source ? Palette.accent-background : transparent;
                    border-width: index == root.drag-target && root.drag-target != root.drag-source ? 1px : 0px;
                    accessible-role: list-item;
                    accessible-label: item.label;
                    Text {
                        x: 8px;
                        width: parent.width - 16px;
                        height: parent.height;
                        text: item.label;
                        color: item.selected ? Palette.selection-foreground : Palette.foreground;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    row-area := TouchArea {
                        double-clicked => {
                            list-focus.focus();
                            root.activated(index);
                        }
                        pointer-event(event) => {
                            if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                                root.drag-source = index;
                                root.drag-target = index;
                            } else if event.kind == PointerEventKind.move && root.drag-source >= 0 {
                                root.drag-target = min(
                                    root.items.length - 1,
                                    max(0, floor((row-area.absolute-position.y + row-area.mouse-y - list-rows.absolute-position.y) / 28px)),
                                );
                            } else if event.kind == PointerEventKind.up && event.button == PointerEventButton.left {
                                list-focus.focus();
                                if root.drag-source >= 0 && root.drag-target >= 0 && root.drag-source != root.drag-target {
                                    root.reordered(root.drag-source, root.drag-target);
                                } else {
                                    root.selected(index, event.modifiers.control, event.modifiers.shift);
                                }
                                root.drag-source = -1;
                                root.drag-target = -1;
                            } else if event.kind == PointerEventKind.up && event.button == PointerEventButton.right {
                                list-focus.focus();
                                root.context-popup-x = min(
                                    row-area.absolute-position.x + row-area.mouse-x - root.absolute-position.x,
                                    root.width - 120px,
                                );
                                root.context-popup-y = min(
                                    row-area.absolute-position.y + row-area.mouse-y - root.absolute-position.y,
                                    root.height - 36px,
                                );
                                root.context-selected(index);
                                remove-popup.show();
                            } else if event.kind == PointerEventKind.cancel {
                                root.drag-source = -1;
                                root.drag-target = -1;
                            }
                        }
                    }
                }
            }
        }
    }

    remove-popup := PopupWindow {
        x: root.context-popup-x;
        y: root.context-popup-y;
        width: 120px;
        height: 36px;

        Rectangle {
            width: parent.width;
            height: parent.height;
            background: Palette.alternate-background;
            border-color: Palette.border;
            border-width: 1px;
            border-radius: 3px;

            popup-focus := FocusScope {
                width: parent.width;
                height: parent.height;
                KeyBinding { keys: @keys(Escape); activated => { remove-popup.close(); } }

                Button {
                    width: parent.width;
                    height: parent.height;
                    text: "Remove";
                    clicked => {
                        remove-popup.close();
                        root.remove-selected();
                    }
                }
            }
        }
    }
}
