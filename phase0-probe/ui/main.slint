import { Button, HorizontalBox, Palette, Slider, VerticalBox } from "std-widgets.slint";

component MixerRow inherits Rectangle {
    in property <string> role;
    height: 52px;
    background: Palette.alternate-background;
    border-color: Palette.border;
    border-width: 1px;
    accessible-role: groupbox;
    accessible-label: role + " mixer";

    HorizontalBox {
        padding: 8px;
        spacing: 8px;

        Text {
            text: role;
            width: 72px;
            vertical-alignment: center;
        }

        Slider {
            value: 0;
            minimum: -60;
            maximum: 6;
            accessible-label: role + " gain";
        }

        Button {
            text: "Mute";
            checkable: true;
        }

        Button {
            text: "Solo";
            checkable: true;
        }
    }
}

export component AppWindow inherits Window {
    title: "Stemplayer Native Phase 0";
    width: 720px;
    height: 520px;
    in-out property <int> drop-count;
    accessible-role: main;
    accessible-label: "Stemplayer native UI proof";

    VerticalBox {
        padding: 16px;
        spacing: 10px;

        Text {
            text: "Stemplayer Native";
            font-size: 24px;
            font-weight: 600;
        }

        Rectangle {
            height: 120px;
            background: Palette.alternate-background;
            border-color: Palette.border;
            border-width: 1px;
            accessible-role: image;
            accessible-label: "Waveform placeholder";

            Text {
                text: parent-drop.has-drag ? "Release to inspect" : "Waveform";
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            parent-drop := DropArea {
                can-drop(event) => { event.proposed-action }
                dropped(event) => {
                    root.drop-count += 1;
                    event.proposed-action
                }
            }
        }

        MixerRow { role: "Drums"; }
        MixerRow { role: "Bass"; }
        MixerRow { role: "Other"; }
        MixerRow { role: "Vocals"; }

        HorizontalBox {
            spacing: 8px;
            Button { text: "Play"; primary: true; }
            Button { text: "Stop"; }
            Text {
                text: drop-count == 0 ? "No drops captured" : drop-count + " drop captured";
                vertical-alignment: center;
            }
        }
    }
}
